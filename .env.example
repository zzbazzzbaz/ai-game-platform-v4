# 模型
MODEL=deepseek:deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 数据库
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent

# 会话 Cookie
SESSION_SECRET=
SESSION_COOKIE=agent_session
SESSION_TTL_SECONDS=2592000

# 阿里云 Agent Sandbox（E2B 协议）
E2B_API_KEY=
E2B_API_URL=https://api.cn-hangzhou.sandbox.aliyuncs.com
E2B_DOMAIN=cn-hangzhou.sandbox.aliyuncs.com
E2B_TEMPLATE=
FCSANDBOX_TEAM_ID=
ALIYUN_REGION=cn-hangzhou

# 沙箱生命周期
SANDBOX_TIMEOUT=600
SANDBOX_HEARTBEAT_SECONDS=240
SANDBOX_ARCHIVE_AFTER_SECONDS=7200
SANDBOX_ARCHIVE_SCAN_SECONDS=300
SANDBOX_WORKSPACE_DIR=/home/user/workspace
SANDBOX_GAME_PORT=3000
SANDBOX_NOVNC_PORT=9000

# 阿里云 OSS（Bucket：ai-game-platform-oss，本地冗余）
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=ai-game-platform-oss
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_PREFIX=ai-game-platform
# 本机访问 OSS 需要代理时填写；生产留空
OSS_PROXY=

# Logfire
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
